{
  "rules": {
    ".read": false,
    ".write": false,
    "live": {
      "menu2": {
        ".read": "auth != null",
        ".write": false
      },
      "config": {
        ".read": "auth != null && (auth.token.role === 'admin' || auth.token.email === 'manager@1708.local')",
        ".write": false,
        "deliveryLog": {
          ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'waiter' || auth.token.role === 'barman' || auth.token.email === 'manager@1708.local')"
        },
        "orderNumResetAt": {
          ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'waiter' || auth.token.role === 'barman' || auth.token.email === 'manager@1708.local')"
        },
        "quizSession": {
          ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'waiter' || auth.token.role === 'barman' || auth.token.email === 'manager@1708.local')"
        }
      },
      "tables": {
        ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'waiter' || auth.token.role === 'barman' || auth.token.email === 'manager@1708.local')",
        ".write": false,
        "$tableId": {
          "note": {
            ".write": false,
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "loggedAt": {
            ".write": false,
            ".validate": "newData.isNumber()"
          }
        }
      },
      "orders": {
        ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'waiter' || auth.token.role === 'barman' || auth.token.email === 'manager@1708.local')",
        ".write": false
      },
      "waiterCalls": {
        ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'waiter' || auth.token.role === 'barman' || auth.token.email === 'manager@1708.local')",
        ".write": false,
        "$callId": {
          "status": {
            ".write": false,
            ".validate": "newData.val() === 'done'"
          }
        }
      },
      "quiz_tokens": {
        ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'waiter' || auth.token.role === 'barman' || auth.token.email === 'manager@1708.local')",
        ".write": false
      },
      "publicCounters": {
        "orderNum": {
          ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'waiter' || auth.token.role === 'barman' || auth.token.email === 'manager@1708.local')",
          ".write": false,
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      },
      "guestOperations": {
        ".read": false,
        ".write": false
      },
      "guestRateLimits": {
        ".read": false,
        ".write": false
      },
      "staffOperations": {
        ".read": false,
        ".write": false
      },
      "maintenance": {
        ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'waiter' || auth.token.role === 'barman' || auth.token.email === 'manager@1708.local')",
        ".write": false
      },
      "pushSubscriptions": {
        ".read": false,
        ".write": false
      },
      "pushOutbox": {
        ".read": false,
        ".write": false
      }
    },
    "archive": {
      ".read": false,
      ".write": false
    },
    "archiveOperations": {
      ".read": false,
      ".write": false
    }
  }
}
