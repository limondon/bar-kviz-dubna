{
  "rules": {
    "menu2": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'manager@1708.local'",
      "$catId": {
        "items": {
          "$itemId": {
            "stock": {
              ".write": "auth != null && (auth.token.email === 'manager@1708.local' || (data.isNumber() && newData.isNumber() && newData.val() >= 0 && newData.val() < data.val()))"
            }
          }
        }
      }
    },
    "config": {
      ".read": "auth != null && auth.token.email === 'manager@1708.local'",
      ".write": "auth != null && auth.token.email === 'manager@1708.local'"
    },
    "tables": {
      ".read": "auth != null",
      "$tableId": {
        ".write": "auth != null && (auth.token.email === 'manager@1708.local' || (!data.exists() && newData.child('autoOpened').val() === true && newData.child('status').val() === 'open'))"
      }
    },
    "orders": {
      ".read": "auth != null && auth.token.email === 'manager@1708.local'",
      "$orderId": {
        ".write": "auth != null && (auth.token.email === 'manager@1708.local' || (!data.exists() && newData.child('source').val() === 'guest' && newData.child('status').val() === 'new' && (!newData.child('createdByUid').exists() || newData.child('createdByUid').val() === auth.uid)))"
      }
    },
    "guestReceipts": {
      ".read": "auth != null && auth.token.email === 'manager@1708.local'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$orderId": {
          ".write": "auth != null && (auth.token.email === 'manager@1708.local' || (auth.uid === $uid && !data.exists() && newData.child('orderId').val() === $orderId && newData.child('orderNum').isNumber() && newData.child('table').exists() && newData.child('createdAt').isNumber()))"
        }
      }
    },
    "waiterCalls": {
      ".read": "auth != null && auth.token.email === 'manager@1708.local'",
      "$callId": {
        ".write": "auth != null && (auth.token.email === 'manager@1708.local' || (!data.exists() && newData.child('status').val() === 'pending'))"
      }
    },
    "quiz_tokens": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'manager@1708.local'"
    },
    "publicCounters": {
      "orderNum": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.email === 'manager@1708.local' || (!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))",
        ".validate": "newData.isNumber() && newData.val() >= 0"
      }
    }
  }
}
